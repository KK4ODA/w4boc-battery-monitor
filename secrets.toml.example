# W4BOC Battery Monitor — secrets.toml
# Never share this file; it is git-ignored and excluded from release zips.

[victron]
# Encryption key. 32 hex characters. Regenerates if the charger's Bluetooth PIN is reset.
encryption_key = "00000000000000000000000000000000"

[email]
# Gmail app password. 16 characters from myaccount.google.com/apppasswords (2FA required). Blank disables email.
app_password = ""

[updater]
# GitHub token. Only for a private repository (fine-grained token, Contents: read).
github_token = ""
