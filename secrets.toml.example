# Template for secrets.toml. Copy this file to `secrets.toml` and fill in
# real values. secrets.toml is git-ignored and never included in release zips.

[victron]
# 32-char hex string from VictronConnect -> your charger -> Product Info ->
# "Encryption data". Regenerates if the charger's Bluetooth PIN is reset.
encryption_key = "00000000000000000000000000000000"

[email]
# Gmail app password (16 chars, no spaces). Generate at
# https://myaccount.google.com/apppasswords with 2FA on the Gmail account.
# Leave the value empty ("") to disable email entirely.
app_password = ""

[updater]
# Only needed if the release repo is private (fine-grained token with
# "Contents: read"). Leave empty for a public repo.
github_token = ""
